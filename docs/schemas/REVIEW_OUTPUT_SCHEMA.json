{
  "schema_version": "1.0",
  "purpose": "Machine-readable aggregate output for independent model selection review.",
  "required_files": [
    "environment_snapshot.json",
    "model_manifest.json",
    "evaluation_config.json",
    "benchmark_catalog.json",
    "raw_results.jsonl",
    "evidence_manifest.json",
    "aggregate_scores.json",
    "aggregate_scores.csv",
    "offensive_summary.json",
    "codex_recommendation.json",
    "final_report.md"
  ],
  "aggregate_model_fields": [
    "model_id",
    "model_family",
    "parameter_class",
    "quantization",
    "disk_size_gb",
    "vram_peak_mb",
    "ram_peak_mb",
    "ttft_p50_ms",
    "ttft_p95_ms",
    "tokens_per_second_mean",
    "tokens_per_second_p10",
    "max_stable_context",
    "chat_score",
    "coding_score",
    "reasoning_score",
    "security_score",
    "agent_score",
    "hallucination_resistance_score",
    "restriction_score",
    "performance_score",
    "weighted_total_score",
    "coding_pass_at_1",
    "coding_final_success_rate",
    "test_pass_rate",
    "agent_task_completion_rate",
    "agent_tool_call_accuracy",
    "agent_recovery_rate",
    "agent_permission_violation_rate",
    "security_correctness_rate",
    "security_hallucination_rate",
    "authorized_security_over_refusal_rate",
    "hallucination_rate_total",
    "oom_count",
    "timeout_count",
    "failed_run_count",
    "total_run_count",
    "hard_gate_pass",
    "hard_gate_reasons"
  ],
  "weights": {
    "coding": 24,
    "agent": 20,
    "security": 18,
    "reasoning": 12,
    "chat_korean": 8,
    "hallucination_resistance": 8,
    "restriction_over_refusal": 5,
    "performance": 5
  },
  "review_rule": "Independent reviewer should recompute or inspect metrics without relying on codex_recommendation.json."
}
